# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/swms

# Redis (background job queue — BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File storage
# Set STORAGE_DRIVER=s3 and fill the AWS_* values to use S3 instead of local disk.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/uploads
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
