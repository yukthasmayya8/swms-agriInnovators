{
  "name": "swms-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "netlify dev",
    "dev:frontend": "vite",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "vite build",
    "build:api": "tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "start:api": "tsx src/run.ts",
    "test": "jest --runInBand",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-smoke.ps1",
    "smoke:request": "powershell -NoProfile -ExecutionPolicy Bypass -File ./smoke_test.ps1"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.2",
    "@netlify/database": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serverless-http": "^4.0.0",
    "shapefile": "^0.6.6",
    "vite": "^5.4.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/shapefile": "^0.6.3",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "start-server-and-test": "^2.0.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
